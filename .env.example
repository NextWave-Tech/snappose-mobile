# Copy this file to .env and fill in your backend URL.
# Locally this is the cloudflared tunnel to the API (see RUN_LOCAL.md in the main repo).
EXPO_PUBLIC_API_URL=https://your-tunnel.trycloudflare.com
# Web OAuth client id (Google Cloud Console → Credentials). Same value as the server's GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
